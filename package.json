{
  "name": "tutorcat",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.mjs\" && vitest run",
    "test:build": "node --test tests/build.check.mjs",
    "tutors:update": "node scripts/import-tutors-from-excel.mjs && node --test \"tests/*.test.mjs\"",
    "tutors:check": "node scripts/import-tutors-from-excel.mjs --check",
    "tutors:template": "node scripts/make-tutor-template.mjs",
    "import:tutors": "node scripts/import-tutors-from-excel.mjs"
  },
  "overrides": {
    "rolldown": "1.2.1"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^20.0.3",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5.8.3",
    "vite": "8.1.5",
    "vitest": "^4.1.10"
  }
}
